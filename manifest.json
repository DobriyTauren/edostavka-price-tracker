{
  "manifest_version": 2,
  "name": "Edostavka Price Tracker",
  "version": "1.0",
  "description": "Отслеживает цену товара на edostavka.by и показывает график изменений прямо на странице. Данные хранятся локально и не передаются на сервер.",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "https://edostavka.by/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": false
  },
  "content_scripts": [
    {
      "matches": ["https://edostavka.by/*"],
      "js": ["content-script.js"]
    }
  ],
  "web_accessible_resources": [
    "chart.min.js"
  ],
  "browser_action": {
    "default_title": "Edostavka Price Tracker",
    "default_popup": "popup.html"
  }
}
